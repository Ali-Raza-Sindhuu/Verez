NODE_ENV=development
PORT=8000

# Comma-separated list if you need more than one (e.g. local + staging)
FRONTEND_URL=http://localhost:5173

DATABASE_URL=postgresql://user:password@localhost:5432/vexez
REDIS_URL=redis://localhost:6379

# Generate strong random secrets, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Separate secret for password-reset links (different from access/refresh secrets)
JWT_RESET_SECRET=
JWT_RESET_EXPIRES_IN=30m

# Only needed if frontend/backend are on different subdomains in production
COOKIE_DOMAIN=

# https://resend.com/api-keys
RESEND_API_KEY=
# Must be a verified sender/domain in your Resend account
RESEND_FROM_EMAIL=noreply@yourdomain.com

# https://console.cloud.google.com/apis/credentials
# Authorized redirect URI must exactly match GOOGLE_REDIRECT_URI below
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# https://github.com/settings/developers -> OAuth Apps -> New OAuth App
# Authorization callback URL must exactly match GITHUB_REDIRECT_URI below
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/api/auth/github/callback