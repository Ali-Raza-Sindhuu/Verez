generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  TEACHER
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  // Optional now: OAuth users (Google/GitHub) never set a password.
  password  String?
  role      Role     @default(STUDENT)

  // Set only for OAuth-created/linked accounts, e.g. "google" | "github".
  provider   String?
  providerId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, providerId])
  @@map("users")
}
